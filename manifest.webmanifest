{
  "id": "fight-timer",
  "name": "Fight Timer — round timer",
  "short_name": "Fight Timer",
  "description": "Round timer for boxing, MMA and kickboxing. Bell on every round, clap at ten seconds left, works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#140505",
  "theme_color": "#140505",
  "categories": [
    "health",
    "fitness",
    "sports",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
